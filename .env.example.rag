# ============================================
# RAG（检索增强生成）系统配置
# ============================================
#
# 核心流程：
# 1. 用户上传文档 → 自动提取文本
# 2. 长文档）→ 生成摘要 + 创建向量索引
# 3. 用户提问 → 语义检索相关文档片段 → 拼接到上下文 → AI 回答
#
# 修改配置后需要重启应用才能生效

# ============================================
# 总开关
# ============================================

# 是否启用 RAG 功能（默认：true）
# 作用：控制整个 RAG 系统的开关
# - 设为 false：完全禁用文档检索，回退到简单的全文注入模式
# - 设为 true：启用智能语义检索
# 影响模块：src/lib/rag/config.ts
RAG_ENABLED=true

# ============================================
# Embedding 模型配置
# ============================================

# 使用的 Embedding 模型（默认：openai/text-embedding-3-small）
# 作用：将文本转换为 1536 维向量，用于语义相似度计算
# - 模型维度：1536
# - 成本：$0.02 / 100 万 tokens（非常便宜）
# - 提供商：通过 OpenRouter API 调用 OpenAI 模型
# - 处理速度：约 1000 tokens/秒
# 影响模块：src/lib/rag/embeddings.ts
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small

# ============================================
# 文档分块配置
# ============================================

# 文档分块大小 - 单位：tokens（默认：600）
# 作用：控制将长文档切分成多少大小的片段进行索引
# 推荐值：
# - 400-800：适合商业文档，平衡精度和上下文完整性
# - 800-1200：适合技术文档，需要更大上下文
# - 200-400：适合精确问答，提高检索精度
# 原理：太小会丢失上下文，太大会降低检索相关性
# 影响模块：src/lib/rag/chunking.ts
RAG_CHUNK_SIZE=600

# 分块重叠大小 - 单位：tokens（默认：100）
# 作用：相邻分块之间的重叠内容，避免关键信息被截断
# 推荐值：分块大小的 10-20%
# - 例如：600 tokens 分块 → 60-120 tokens 重叠
# - 增加重叠：提高上下文连贯性，但增加存储和计算成本
# - 减少重叠：节省存储，但可能在分块边界处丢失语义
# 影响模块：src/lib/rag/chunking.ts
RAG_CHUNK_OVERLAP=100

# ============================================
# 文件处理策略
# ============================================

# 长文档阈值 - 单位：字节（默认：0 = 0KB）
# 作用：判断文件是否需要做 RAG 处理
# - 文件 < 50KB：直接注入全文到上下文（不做向量索引）
# - 文件 ≥ 50KB：生成摘要 + 创建向量索引
# 检索
# 影响模块：src/lib/rag/file-processor.ts
RAG_LONG_FILE_THRESHOLD=0

# ============================================
# 跨对话检索
# ============================================

# 是否启用跨对话检索（默认：true）
# 作用：控制是否在历史对话的文档中检索相关信息
# - 设为 true：可以在当前对话中引用历史文档（更强大）
# - 设为 false：只检索当前对话的文档（更安全、更快）
# 使用场景：
# - 启用：用户经常需要在多个对话间引用相关文档
# - 禁用：每个对话独立，不需要跨对话检索
# 影响模块：src/lib/agent/nodes/preprocess.ts
RAG_CROSS_CONV_ENABLED=true

# ============================================
# 功能开关
# ============================================

# 是否生成文档摘要（默认：true）
# 作用：为长文档自动生成 3-5 句话的摘要
# - 摘要内容：主要主题、关键信息、核心业务数据
# - 使用的模型：Claude 3.5 Sonnet（通过 OpenRouter）
# - 用途：快速了解文档内容、优化检索
# 成本：每次摘要生成约消耗 500-1000 tokens
# 影响模块：src/lib/rag/file-processor.ts
RAG_ENABLE_SUMMARIZATION=true

# 是否创建向量索引（默认：true）
# 作用：是否为文档生成向量 Embeddings 并存入数据库
# - 设为 true：启用语义检索功能
# - 设为 false：只生成摘要，不做向量检索
# 影响：如果关闭，用户提问时无法智能检索相关片段
# 影响模块：src/lib/rag/file-processor.ts
RAG_ENABLE_VECTOR_INDEX=true

# ============================================
# 必需依赖
# ============================================

# OpenRouter API 密钥（必需）
# 作用：调用 OpenRouter API 生成 Embeddings
# 获取方式：https://openrouter.ai/keys
# 格式：sk-or-...
# 注意：这个密钥应该已经在 .env.local 中配置
# 影响模块：src/lib/rag/embeddings.ts
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ============================================
# 当前对话检索参数（高级配置）
# ============================================

# 当前对话检索 - 最小相似度阈值（默认：0.70，范围：0.0-1.0）
# 作用：过滤低相关性的检索结果
# - 提高阈值（如 0.80）：只返回高度相关的片段，减少噪声，但可能漏掉相关内容
# - 降低阈值（如 0.60）：返回更多可能相关的内容，提高召回率，但可能引入无关信息
# 说明：0.70 表示相似度达到 70% 才会被采纳
# 影响模块：src/lib/rag/vector-db.ts 的 searchSimilarChunks 函数
# RAG_CURRENT_CONV_THRESHOLD=0.70

# 当前对话检索 - 最大返回结果数（默认：5）
# 作用：限制返回的相关片段数量
# - 增加数量（如 10）：提供更多上下文，但增加 token 消耗
# - 减少数量（如 3）：减少 token 消耗，但可能遗漏重要信息
# 影响模块：src/lib/rag/vector-db.ts 的 searchSimilarChunks 函数
# RAG_CURRENT_CONV_MAX_RESULTS=5

# ============================================
# 跨对话检索参数（高级配置）
# ============================================

# 跨对话检索 - 最小相似度阈值（默认：0.75，范围：0.0-1.0）
# 作用：过滤跨对话检索的低相关性结果
# - 默认比当前对话更严格（0.75 vs 0.70）
# - 原因：历史文档的相关性通常不如当前文档，需要更严格的过滤
# - 提高阈值（如 0.85）：只引用高度相关的历史文档
# - 降低阈值（如 0.70）：更容易引用历史文档，但可能引入不相关内容
# 影响模块：src/lib/rag/vector-db.ts 的 searchCrossConversations 函数
# RAG_CROSS_CONV_THRESHOLD=0.75

# 跨对话检索 - 最大返回结果数（默认：3）
# 作用：限制从其他对话返回的相关片段数量
# - 增加数量（如 5）：提供更多历史上下文
# - 减少数量（如 1）：减少历史文档干扰
# 说明：通常比当前对话返回更少，优先当前对话的内容
# 影响模块：src/lib/rag/vector-db.ts 的 searchCrossConversations 函数
# RAG_CROSS_CONV_MAX_RESULTS=3

# ============================================
# 性能调优（高级配置）
# ============================================

# Embedding 批处理大小（默认：100，最大：2048）
# 作用：一次性批量生成多少个文本的向量
# - 增加批量（如 200）：减少 API 调用次数，加快处理速度，但占用更多内存
# - 减少批量（如 50）：降低内存占用，但增加 API 调用次数
# 成本影响：批量大小不影响 API 成本（OpenRouter 按 tokens 计费）
# 影响模块：src/lib/rag/config.ts
# RAG_EMBEDDING_BATCH_SIZE=100

# ============================================
# 配置示例与场景
# ============================================

# 场景 1：快速测试（低成本）
# RAG_ENABLED=true
# RAG_LONG_FILE_THRESHOLD=100000  # 只对 >100KB 的文档做索引
# RAG_CHUNK_SIZE=800  # 更大的分块，减少片段数
# RAG_CURRENT_CONV_MAX_RESULTS=3  # 更少的检索结果

# 场景 2：高精度检索
# RAG_ENABLED=true
# RAG_CHUNK_SIZE=400  # 更小的分块，提高精度
# RAG_CHUNK_OVERLAP=80
# RAG_CURRENT_CONV_THRESHOLD=0.80  # 更高的阈值
# RAG_CROSS_CONV_ENABLED=true

# 场景 3：仅当前对话（禁用跨对话检索）
# RAG_ENABLED=true
# RAG_CROSS_CONV_ENABLED=false
# RAG_ENABLE_SUMMARIZATION=true
# RAG_ENABLE_VECTOR_INDEX=true

# 场景 4：完全禁用 RAG（回退到简单模式）
# RAG_ENABLED=false
